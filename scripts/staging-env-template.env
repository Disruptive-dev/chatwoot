# OptimiA Staging — variables mínimas Connection Center + Evolution
# Copiar a EasyPanel (servicios chatwoot y chatwoot-sidekiq). NO usar en producción.

FRONTEND_URL=https://staging.optimia.spectra-metrics.com
OPTIMIA_CHATWOOT_PUBLIC_URL=https://staging.optimia.spectra-metrics.com

# Evolution API (server-side only)
EVOLUTION_API_URL=https://evo-api.spectra-metrics.com
EVOLUTION_API_KEY=__REQUIRED__

# Token API Chatwoot para integración Evolution → Chatwoot (crear usuario admin/bot en staging)
OPTIMIA_EVOLUTION_CHATWOOT_API_TOKEN=__REQUIRED__

# Feature gates
OPTIMIA_CHANNEL_MANAGER_ENABLED=true
OPTIMIA_EVOLUTION_INSTANCE_PREFIX=optimia-stg

# Infra staging (aislada de prod)
# POSTGRES_HOST=chatwoot-db
# REDIS_URL=redis://:password@chatwoot-redis:6379
# SECRET_KEY_BASE=__REQUIRED__
